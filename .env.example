# AI Finder — optional build-time settings. Copy to .env.production if needed.
#
# Where the browser sends FreeSerp requests.
# Leave empty (default) to use the bundled PHP proxy: api/freeserp.php
# Set it to your Cloudflare Worker URL when the hosting has no PHP
# (see deploy/cloudflare-worker.js), e.g.:
# VITE_API_BASE=https://ai-finder-proxy.your-name.workers.dev
VITE_API_BASE=

# Public address of the site, used for canonical links, Open Graph tags,
# sitemap.xml and robots.txt (default: https://ws-58.ws.semalt.dev).
VITE_SITE_URL=

# Base path when the site lives in a sub-folder, e.g. /ai-finder/ (default: /).
# Remember to update ErrorDocument in public/.htaccess accordingly.
VITE_BASE=
